{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "graph-record.schema.json",
  "title": "Reality Bender - Evento de conhecimento do grafo",
  "description": "Registro imutável de uma ação. Cada arquivo é um nó file:<path>, cada ação um nó action:<id>, e links formam arestas direcionadas.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "recordedAt",
    "agent",
    "intent",
    "summary",
    "status",
    "files",
    "checks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,}$"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "done",
        "partial",
        "blocked"
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "change",
          "summary",
          "links"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          },
          "change": {
            "enum": [
              "created",
              "modified",
              "deleted",
              "renamed",
              "reviewed",
              "tested"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "links": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "to",
                "type",
                "reason"
              ],
              "properties": {
                "to": {
                  "$ref": "#/$defs/path"
                },
                "type": {
                  "enum": [
                    "depends_on",
                    "implements",
                    "uses",
                    "tests",
                    "documents",
                    "configures",
                    "invokes",
                    "references",
                    "relates_to",
                    "supersedes",
                    "governed_by",
                    "imports",
                    "renders",
                    "communicates_with"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "status",
          "notes"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not_run"
            ]
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "description": "Caminho relativo à raiz do repo, separador /, sem ./, .., barra inicial ou final. A CLI aplica a validação completa."
    }
  }
}
